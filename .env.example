SARVAM_API_KEY=

# 1 real second = this many simulated seconds. 900 => 1s == 15 simulated minutes.
CLOCK_SCALE=900

# Simulated wall-clock the demo starts at.
SIM_START=13:45

# 1 = never call the network, replay cache/ only. Fails loudly if a response is missing.
OFFLINE=0

# 1 = no network, no cache needed, deterministic canned responses. Dev only.
# Auto-enabled when SARVAM_API_KEY is empty.
MOCK=0
